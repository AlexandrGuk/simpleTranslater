{
  "name": "Simple Translator",
  "version": "1.2.0",
  "manifest_version": 3,
  "description": "Выдели текст на латинице и посмотри перевод на русский.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": "icons/icon48.png",
    "default_popup": "popup.html",
    "default_title": "Simple Translator"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://browser.translate.yandex.net/*",
    "https://alxgk.site/*",
    "https://www.alxgk.site/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "minimum_chrome_version": "102",
  "browser_specific_settings": {
    "gecko": {
      "id": "simple-translator@alxgk.ru",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["contentScript.js"],
      "all_frames": true
    }
  ]
}
